      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/mcp/server.py"
      ],
      "env": {
        "APPLICATION_TRACKER_PATH": "C:/YOUR_DATA/applications.xlsx",
